{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-point v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_content_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "classification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "verification_status": {
          "const": "unverified"
        }
      },
      "required": [
        "name",
        "aliases",
        "classification",
        "related_ids",
        "verification_status"
      ],
      "additionalProperties": false
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "description": "程序在关联本次学习规划时填写；兼容此前未关联的独立记录。"
    }
  },
  "required": [
    "schema_version",
    "id",
    "run_id",
    "paper_id",
    "paper_content_id",
    "created_at",
    "content"
  ],
  "additionalProperties": false
}
