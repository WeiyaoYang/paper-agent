{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "理解验证问答记录",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_content_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "object",
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "enum": [
            "passed",
            "needs_more_learning",
            "insufficient_evidence"
          ]
        },
        "evaluations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "type": "string",
                "minLength": 1
              },
              "assessment": {
                "enum": [
                  "correct",
                  "partial",
                  "incorrect",
                  "insufficient_evidence"
                ]
              },
              "reference_answer": {
                "type": "string",
                "minLength": 1
              },
              "feedback": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "question_id",
              "assessment",
              "reference_answer",
              "feedback"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "paper_id": {
                "type": "string",
                "minLength": 1
              },
              "paper_content_id": {
                "type": "string",
                "minLength": 1
              },
              "pdf_page": {
                "type": "integer",
                "minimum": 1
              },
              "block_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "paper_id",
              "paper_content_id",
              "pdf_page",
              "block_id",
              "quote"
            ],
            "additionalProperties": false
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "plan_id",
        "goal",
        "assessment",
        "evaluations",
        "summary",
        "sources",
        "unresolved_questions"
      ],
      "additionalProperties": false
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "verification_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "user_answer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "question",
          "goal",
          "user_answer"
        ],
        "additionalProperties": false
      }
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "description": "程序在关联本次学习规划时填写；兼容此前未关联的独立记录。"
    }
  },
  "required": [
    "schema_version",
    "id",
    "run_id",
    "paper_id",
    "paper_content_id",
    "created_at",
    "content",
    "messages",
    "verification_questions"
  ],
  "additionalProperties": false
}
